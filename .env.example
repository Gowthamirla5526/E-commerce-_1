# Database Connection
# Local SQLite: "file:./dev.db"
# Production PostgreSQL: "postgresql://user:password@localhost:5432/fresh_harvest?schema=public"
DATABASE_URL="file:./dev.db"

# Public Brand & Locale Settings
NEXT_PUBLIC_APP_NAME="Fresh Harvest"
NEXT_PUBLIC_APP_TAGLINE="Next-Generation Perishable Produce Commerce"
NEXT_PUBLIC_CURRENCY_CODE="INR"
NEXT_PUBLIC_LOCALE="en-IN"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Kolkata"

# Payment Adapter
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
